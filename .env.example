# --- General ---------------------------------------------------------
ENVIRONMENT=development

# --- LLM / Embeddings (OpenAI-compatible; point OPENAI_BASE_URL at any
# OpenAI-compatible provider — Azure OpenAI, vLLM, etc.) ----------------
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Vector store (Qdrant) ---------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks

# --- Relational DB (metadata) -------------------------------------------
# SQLite (default, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./rag_backend.db
# Postgres example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/rag_backend

# --- Redis (chat memory + booking session state) -------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_CHAT_TTL_SECONDS=86400
REDIS_MAX_HISTORY_MESSAGES=12

# --- Chunking defaults ----------------------------------------------------
FIXED_CHUNK_SIZE=800
FIXED_CHUNK_OVERLAP=120
SEMANTIC_CHUNK_TARGET_SIZE=900
SEMANTIC_CHUNK_MAX_SIZE=1400

# --- Retrieval ---------------------------------------------------------------
RETRIEVAL_TOP_K=4
RETRIEVAL_SCORE_THRESHOLD=0.0

# --- Upload limits -------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=25
